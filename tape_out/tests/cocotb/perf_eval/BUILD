    "VCS_BUILD_ARGS",
    "VCS_DEFINES",
    "VCS_TEST_ARGS",
)

package(default_visibility = ["//visibility:public"])

exports_files([
    "gemm_test.cc",
    "cocotb_gemm.py",
])

