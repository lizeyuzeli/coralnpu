    name = "gemm_test_binary",
    srcs = ["gemm_test.cc"],
    dtcm_size_kbytes = 1024,  # Highmem
    itcm_size_kbytes = 1024,  # Highmem
    deps = [
        "//tape_out/sw/opt/litert-micro:gemm",
    ],
)

